<launch>
  <!-- mock 业务默认来自 executor_defaults.yaml（mock.* 段）；故障值/覆盖由命令行显式传入，
       arg 默认空，仅显式传入时条件写入（implementation_plan_26083018 §3）。 -->
  <arg name="uav_id" /> <arg name="exec_target" />
  <arg name="service_namespace" default="$(arg exec_target)" />
  <arg name="state_topic" default="/$(arg service_namespace)/uav_task_state" />
  <arg name="result_delay_s" default="" /> <arg name="final_success" default="" />
  <arg name="error_code" default="" /> <arg name="message" default="" />
  <arg name="hold_success" default="" />
  <node pkg="swarm_uav_executor" type="uav_executor_node.py" name="uav_executor_$(arg uav_id)" output="screen" required="true">
    <rosparam command="load" file="$(find swarm_uav_executor)/config/executor_defaults.yaml" />
    <param name="uav_id" value="$(arg uav_id)" /> <param name="exec_target" value="$(arg exec_target)" />
    <param name="service_namespace" value="$(arg service_namespace)" /> <param name="state_topic" value="$(arg state_topic)" />
    <param name="driver" value="mock" />
    <param name="mock/result_delay_s" value="$(arg result_delay_s)" if="$(eval arg('result_delay_s') != '')" />
    <param name="mock/final_success" value="$(arg final_success)" if="$(eval arg('final_success') != '')" />
    <param name="mock/error_code" value="$(arg error_code)" if="$(eval arg('error_code') != '')" />
    <param name="mock/message" value="$(arg message)" if="$(eval arg('message') != '')" />
    <param name="mock/hold_success" value="$(arg hold_success)" if="$(eval arg('hold_success') != '')" />
    <rosparam param="supported_commands">[MOVE_TO, FOLLOW_ROUTE, FAULT_EXIT, HOVER]</rosparam>
  </node>
</launch>
