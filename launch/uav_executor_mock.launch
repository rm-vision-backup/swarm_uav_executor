<launch>
  <arg name="uav_id" /> <arg name="exec_target" />
  <arg name="service_namespace" default="$(arg exec_target)" />
  <arg name="state_topic" default="/$(arg service_namespace)/uav_task_state" />
  <arg name="result_delay_s" default="0.5" /> <arg name="final_success" default="true" />
  <arg name="error_code" default="" /> <arg name="message" default="mock UAV task finished" />
  <arg name="hold_success" default="true" />
  <node pkg="swarm_uav_executor" type="uav_executor_node.py" name="uav_executor_$(arg uav_id)" output="screen" required="true">
    <rosparam command="load" file="$(find swarm_uav_executor)/config/executor_defaults.yaml" />
    <param name="uav_id" value="$(arg uav_id)" /> <param name="exec_target" value="$(arg exec_target)" />
    <param name="service_namespace" value="$(arg service_namespace)" /> <param name="state_topic" value="$(arg state_topic)" />
    <param name="driver" value="mock" /> <param name="mock/result_delay_s" value="$(arg result_delay_s)" />
    <param name="mock/final_success" value="$(arg final_success)" /> <param name="mock/error_code" value="$(arg error_code)" />
    <param name="mock/message" value="$(arg message)" /> <param name="mock/hold_success" value="$(arg hold_success)" />
    <rosparam param="supported_commands">[MOVE_TO, FOLLOW_ROUTE, FAULT_EXIT, HOVER]</rosparam>
  </node>
</launch>
