<launch>
  <arg name="uav_id" />
  <arg name="exec_target" />
  <arg name="service_namespace" default="$(arg exec_target)" />
  <arg name="state_topic" default="/$(arg service_namespace)/uav_task_state" />
  <arg name="interfaces_version" default="deployment-unset" />
  <arg name="neighbor_intents" default="" />
  <!-- 主动 rebound 业务默认来自 planner_defaults.yaml（enable_rebound=false）；arg 默认空，
       仅测试/诊断 launch 显式覆盖为 true 时条件写入（implementation_plan_26083018 §3）。 -->
  <arg name="enable_rebound" default="" />
  <arg name="mavros_state_topic" default="/mavros/state" />
  <!-- 编队槽位: YAML 字典 uav_id -> [x, y, z]（ENU，相对 leader），可空 -->
  <arg name="formation_offsets" default="{}" />
  <!-- leader odom 话题前缀: 如空则自动按 /<leader>/mavros/local_position/odom 构造 -->
  <arg name="leader_odom_topic_prefix" default="" />
  <arg name="neighbor_odom_topics" default="" />
  <!-- configure_px4_params 业务默认来自 ego_swarm_defaults.yaml（false）；launch arg 默认空，
       仅命令行显式传入时条件写入（PX4 参数由 takeoff 脚本负责）。 -->
  <arg name="configure_px4_params" default="" />
  <!-- 任务执行超时（DRIVER_TIMEOUT 兜底）：业务默认来自 ego_swarm_defaults.yaml
       (task_timeout_s=200.0)；arg 默认空，长任务由上层 launch 显式覆盖。 -->
  <arg name="uav_task_timeout_s" default="" />
  <!-- ego HOLD/收口超时（HOLD 确认、任务失败回退、shutdown join）：业务默认来自
       executor_defaults.yaml（ego_hold_timeout_s=2.0）；arg 默认空，可在上层 launch 覆盖。 -->
  <arg name="ego_hold_timeout_s" default="" />
  <!-- Predictive safety supervision 业务默认来自 safety_defaults.yaml（active）；arg 默认空，
       仅命令行显式覆盖时条件写入（诊断可 shadow/off）。 -->
  <arg name="safety_supervisor_mode" default="" />
  <arg name="diagnostic_log_dir"
       default="$(env HOME)/catkin_swarm6-2/runtime_logs/ego_planner" />
  <!-- 执行器/relay 事件日志目录（2026-10-08 增）。arg 默认空、仅非空时条件写入——
       仓库约定：launch 不内联业务默认；rostest 展开本 launch 时不应往真实目录落文件。
       上层实机/仿真入口显式传入 runtime_logs/health。 -->
  <arg name="event_log_dir" default="" />

  <!-- Identity parameters live at global scope (/uav_id, /exec_target) the
       Python EgoSwarmDriver and topology bridge can discover them. -->
  <param name="uav_id" value="$(arg uav_id)" />
  <param name="exec_target" value="$(arg exec_target)" />

  <node pkg="ego_planner_driver" type="ego_planner_driver_node"
        name="ego_planner_driver" output="screen">
    <!-- canonical 三份配置（与 standalone ego_planner_driver.launch 同一来源）：
         业务默认一律来自 YAML；此处仅 identity/path/明确 deployment override。 -->
    <rosparam command="load" file="$(find ego_planner_driver)/config/planner_defaults.yaml" />
    <rosparam command="load" file="$(find ego_planner_driver)/config/safety_defaults.yaml" />
    <rosparam command="load" file="$(find ego_planner_driver)/config/resource_limits.yaml" />
    <param name="uav_id" value="$(arg uav_id)" />
    <param name="exec_target" value="$(arg exec_target)" />
    <param name="frame_id" value="map" />
    <param name="setpoint_out_topic" value="/setpoint/ego" />
    <param name="safety_supervisor_mode" value="$(arg safety_supervisor_mode)" if="$(eval arg('safety_supervisor_mode') != '')" />
    <param name="diagnostic_log_dir" value="$(arg diagnostic_log_dir)" />
    <param name="diagnostic_log_queue_size" value="2048" />
    <!-- enable_rebound 为诊断/测试 deployment override（canonical 默认 false，见 planner_defaults.yaml）。 -->
    <param name="enable_rebound" value="$(arg enable_rebound)" if="$(eval arg('enable_rebound') != '')" />
  </node>

  <!-- 位姿中继：/mavros/local_position/pose -> /local_pose（ego driver 依赖） -->
  <node pkg="swarm_uav_executor" type="pose_relay_node.py"
        name="pose_relay" output="screen">
    <param name="source_topic" value="/mavros/local_position/pose" />
    <param name="target_topic" value="/local_pose" />
  </node>

  <!-- setpoint_relay：/mavros/setpoint_raw/local 的唯一 MAVROS setpoint 发布者。
       订阅两个 PositionTarget 候选源（EGO /setpoint/ego、follower /setpoint/follower）、
       选源 Bool 与本机 local pose；仲裁、freshness/finite 校验、模式 generation 隔离，
       失效/切换期输出固定 position/yaw HOLD。禁止任何其他节点发布 MAVROS setpoint。 -->
  <node pkg="swarm_uav_executor" type="setpoint_relay_node.py"
        name="setpoint_relay" output="screen">
    <param name="ego_topic" value="/setpoint/ego" />
    <param name="follower_topic" value="/setpoint/follower" />
    <param name="mode_topic" value="/direct_control_active" />
    <param name="local_pose_topic" value="/mavros/local_position/pose" />
    <param name="output_topic" value="/mavros/setpoint_raw/local" />
    <!-- 冻结契约：relay 30Hz、candidate timeout 0.2s、pose timeout 1.0s。 -->
    <param name="rate_hz" value="30.0" />
    <param name="candidate_timeout_s" value="0.2" />
    <param name="local_pose_timeout_s" value="1.0" />
    <param name="event_log_dir" value="$(arg event_log_dir)" if="$(eval arg('event_log_dir') != '')" />
  </node>

  <node pkg="swarm_uav_executor" type="uav_executor_node.py"
        name="uav_executor_$(arg uav_id)" output="screen" required="true">
    <!-- 通用 executor 默认 + EGO driver 默认（canonical YAML）；launch 仅 deployment override。 -->
    <rosparam command="load" file="$(find swarm_uav_executor)/config/executor_defaults.yaml" />
    <rosparam command="load" file="$(find swarm_uav_executor)/config/ego_swarm_defaults.yaml" />
    <param name="uav_id" value="$(arg uav_id)" />
    <param name="exec_target" value="$(arg exec_target)" />
    <param name="service_namespace" value="$(arg service_namespace)" />
    <param name="state_topic" value="$(arg state_topic)" />
    <param name="interfaces_version" value="$(arg interfaces_version)" />
    <param name="driver" value="ego_swarm" />
    <param name="require_explicit_start" value="true" />
    <rosparam param="supported_commands">[MOVE_TO, FOLLOW_ROUTE, FAULT_EXIT, HOVER]</rosparam>
    <!-- ego HOLD/收口超时（HOLD 确认、任务失败回退、shutdown join）独立于任务执行超时；
         canonical 默认 2.0（executor_defaults.yaml），仅显式传入时条件写入。 -->
    <param name="ego_hold_timeout_s" value="$(arg ego_hold_timeout_s)" if="$(eval arg('ego_hold_timeout_s') != '')" />
    <!-- deployment override（YAML 已含默认）：任务超时、邻机 intent、编队、PX4 参数策略 -->
    <param name="ego_swarm/task_timeout_s" value="$(arg uav_task_timeout_s)" if="$(eval arg('uav_task_timeout_s') != '')" />
    <param name="ego_swarm/neighbor_intents" value="$(arg neighbor_intents)" />
    <param name="ego_swarm/mavros_state_topic" value="$(arg mavros_state_topic)" />
    <rosparam param="ego_swarm/formation_offsets" subst_value="true">$(arg formation_offsets)</rosparam>
    <param name="ego_swarm/leader_odom_topic_prefix" value="$(arg leader_odom_topic_prefix)" />
    <param name="ego_swarm/neighbor_odom_topics" value="$(arg neighbor_odom_topics)" />
    <param name="ego_swarm/configure_px4_params" value="$(arg configure_px4_params)" if="$(eval arg('configure_px4_params') != '')" />
    <!-- 跟随环事件日志（领机首帧/空档/退出原因）——不经 rosout，直接写文件。 -->
    <param name="ego_swarm/event_log_dir" value="$(arg event_log_dir)" if="$(eval arg('event_log_dir') != '')" />
  </node>
</launch>
