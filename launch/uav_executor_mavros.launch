<launch>
  <!-- Safety baseline: this launch never arms the vehicle or changes flight mode. -->
  <arg name="uav_id" />
  <arg name="exec_target" />
  <arg name="service_namespace" default="$(arg exec_target)" />
  <arg name="state_topic" default="/$(arg service_namespace)/uav_task_state" />
  <arg name="interfaces_version" default="deployment-unset" />
  <!-- legacy 业务默认来自 mavros_position_legacy.yaml（namespace=/mavros、frame_id=map、
       require_* / auto_* 全部 false）；launch arg 默认空，仅命令行显式传入时条件写入，
       不保存第二套默认（implementation_plan_26083018 §3）。 -->
  <arg name="mavros_namespace" default="" />
  <arg name="frame_id" default="" />
  <arg name="require_armed" default="" />
  <arg name="require_offboard" default="" />
  <arg name="auto_arm" default="" />
  <arg name="auto_offboard" default="" />

  <node pkg="swarm_uav_executor" type="uav_executor_node.py"
        name="uav_executor_$(arg uav_id)" output="screen" required="true">
    <rosparam command="load" file="$(find swarm_uav_executor)/config/executor_defaults.yaml" />
    <rosparam command="load" file="$(find swarm_uav_executor)/config/mavros_position_legacy.yaml" />
    <param name="uav_id" value="$(arg uav_id)" />
    <param name="exec_target" value="$(arg exec_target)" />
    <param name="service_namespace" value="$(arg service_namespace)" />
    <param name="state_topic" value="$(arg state_topic)" />
    <param name="interfaces_version" value="$(arg interfaces_version)" />
    <param name="driver" value="mavros_position" />
    <!-- legacy 部署 override：namespace/frame_id/require_* 等实验/实机入口 -->
    <param name="mavros_position/namespace" value="$(arg mavros_namespace)" if="$(eval arg('mavros_namespace') != '')" />
    <param name="mavros_position/frame_id" value="$(arg frame_id)" if="$(eval arg('frame_id') != '')" />
    <param name="mavros_position/require_armed" value="$(arg require_armed)" if="$(eval arg('require_armed') != '')" />
    <param name="mavros_position/require_offboard" value="$(arg require_offboard)" if="$(eval arg('require_offboard') != '')" />
    <param name="mavros_position/auto_arm" value="$(arg auto_arm)" if="$(eval arg('auto_arm') != '')" />
    <param name="mavros_position/auto_offboard" value="$(arg auto_offboard)" if="$(eval arg('auto_offboard') != '')" />
  </node>
</launch>